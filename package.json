{
  "name": "akfu-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "tsx backend.ts",
    "build": "tsc backend.ts --ignoreConfig --target es2020 --module commonjs --esModuleInterop --allowSyntheticDefaultImports --skipLibCheck --strict false --outDir . && next build",
    "start": "node backend.js",
    "start:next": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "next": "^14.0.0",
    "zustand": "^4.4.7",
    "axios": "^1.6.5",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.0.0"
  }
}
